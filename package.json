{
  "name": "skillfactory-qc-workbench",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "db:init": "pnpm --filter server db:init"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2"
  }
}
